# keycloak-extensions-sit – build_jar.sh Konfiguration
# Kopieren nach .env und anpassen.

# Ziel-Keycloak-Version (muss mit der Serverversion übereinstimmen)
KC_VERSION=26.7.4

# Provider-Version (default: aus pom.xml)
VERSION=1.5.3

# Maven Docker Image (default: maven:3.9-eclipse-temurin-17)
# MAVEN_IMAGE=maven:3.9-eclipse-temurin-17

# Ausgabeverzeichnis (default: ./dist)
# OUTPUT_DIR=./dist
